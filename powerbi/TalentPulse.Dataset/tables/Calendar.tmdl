table Calendar
	isHidden: false

	column Date
		dataType: dateTime
		isKey: true
		isAvailableInMdx: true
		formatString: yyyy-mm-dd
		lineageTag: col-calendar-date
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		lineageTag: col-calendar-year
		summarizeBy: sum
		sourceColumn: Year

	column MonthNumber
		dataType: int64
		isHidden: true
		lineageTag: col-calendar-monthnumber
		summarizeBy: sum
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		lineageTag: col-calendar-monthname
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	column Quarter
		dataType: string
		lineageTag: col-calendar-quarter
		summarizeBy: none
		sourceColumn: Quarter

	column IsWeekend
		dataType: boolean
		lineageTag: col-calendar-isweekend
		summarizeBy: none
		sourceColumn: IsWeekend

	partition Calendar = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(
			        File.Contents(DataFolder & "dim_date.csv"),
			        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
			    ),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(
			        PromotedHeaders,
			        {
			        {"Date", type date},
			        {"Year", Int64.Type},
			        {"MonthNumber", Int64.Type},
			        {"MonthName", type text},
			        {"Quarter", type text},
			        {"IsWeekend", type logical}
			        },
			        "en-US"
			    )
			in
			    Typed
			```

	annotation PBI_ResultType = Table
