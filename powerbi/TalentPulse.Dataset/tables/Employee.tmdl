table Employee

	column EmployeeKey
		dataType: int64
		isHidden: true
		isKey: true
		lineageTag: col-employee-key
		summarizeBy: none
		sourceColumn: EmployeeKey

	column EmployeeCode
		dataType: string
		lineageTag: col-employee-code
		summarizeBy: none
		sourceColumn: EmployeeCode

	column Gender
		dataType: string
		lineageTag: col-employee-gender
		summarizeBy: none
		sourceColumn: Gender

	column BirthYear
		dataType: int64
		isHidden: true
		lineageTag: col-employee-birthyear
		summarizeBy: none
		sourceColumn: BirthYear

	column HireDate
		dataType: dateTime
		lineageTag: col-employee-hiredate
		summarizeBy: none
		sourceColumn: HireDate

	column TerminationDate
		dataType: dateTime
		lineageTag: col-employee-termdate
		summarizeBy: none
		sourceColumn: TerminationDate

	column TerminationType
		dataType: string
		lineageTag: col-employee-termtype
		summarizeBy: none
		sourceColumn: TerminationType

	column TerminationReason
		dataType: string
		lineageTag: col-employee-termreason
		summarizeBy: none
		sourceColumn: TerminationReason

	column HireSourceKey
		dataType: int64
		isHidden: true
		lineageTag: col-employee-hiresourcekey
		summarizeBy: none
		sourceColumn: HireSourceKey

	column WorkModel
		dataType: string
		lineageTag: col-employee-workmodel
		summarizeBy: none
		sourceColumn: WorkModel

	column EmploymentType
		dataType: string
		lineageTag: col-employee-emptype
		summarizeBy: none
		sourceColumn: EmploymentType

	column FTE
		dataType: decimal
		lineageTag: col-employee-fte
		summarizeBy: sum
		sourceColumn: FTE

	column OrgUnitKey
		dataType: int64
		isHidden: true
		lineageTag: col-employee-orgunitkey
		summarizeBy: none
		sourceColumn: OrgUnitKey

	column LocationKey
		dataType: int64
		isHidden: true
		lineageTag: col-employee-locationkey
		summarizeBy: none
		sourceColumn: LocationKey

	column CurrentJobKey
		dataType: int64
		isHidden: true
		lineageTag: col-employee-currentjobkey
		summarizeBy: none
		sourceColumn: CurrentJobKey

	column IsActive
		dataType: int64
		lineageTag: col-employee-isactive
		summarizeBy: sum
		sourceColumn: IsActive

	partition Employee = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(
			        File.Contents(DataFolder & "dim_employee.csv"),
			        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
			    ),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(
			        PromotedHeaders,
			        {
			        {"EmployeeKey", Int64.Type},
			        {"EmployeeCode", type text},
			        {"Gender", type text},
			        {"BirthYear", Int64.Type},
			        {"HireDate", type date},
			        {"TerminationDate", type date},
			        {"TerminationType", type text},
			        {"TerminationReason", type text},
			        {"HireSourceKey", Int64.Type},
			        {"WorkModel", type text},
			        {"EmploymentType", type text},
			        {"FTE", Currency.Type},
			        {"OrgUnitKey", Int64.Type},
			        {"LocationKey", Int64.Type},
			        {"CurrentJobKey", Int64.Type},
			        {"IsActive", Int64.Type}
			        },
			        "en-US"
			    )
			in
			    Typed
			```

	annotation PBI_ResultType = Table
