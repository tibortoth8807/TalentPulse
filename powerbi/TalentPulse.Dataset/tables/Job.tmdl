table Job

	column JobKey
		dataType: int64
		isHidden: true
		isKey: true
		lineageTag: col-job-key
		summarizeBy: none
		sourceColumn: JobKey

	column JobTitle
		dataType: string
		lineageTag: col-job-title
		summarizeBy: none
		sourceColumn: JobTitle

	column Level
		dataType: string
		lineageTag: col-job-level
		summarizeBy: none
		sourceColumn: Level
		sortByColumn: LevelOrder

	column LevelOrder
		dataType: int64
		isHidden: true
		lineageTag: col-job-levelorder
		summarizeBy: none
		sourceColumn: LevelOrder

	column Department
		dataType: string
		lineageTag: col-job-dept
		summarizeBy: none
		sourceColumn: Department

	partition Job = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(
			        File.Contents(DataFolder & "dim_job.csv"),
			        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
			    ),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(
			        PromotedHeaders,
			        {
			        {"JobKey", Int64.Type},
			        {"JobTitle", type text},
			        {"Level", type text},
			        {"LevelOrder", Int64.Type},
			        {"Department", type text}
			        },
			        "en-US"
			    )
			in
			    Typed
			```

	annotation PBI_ResultType = Table
