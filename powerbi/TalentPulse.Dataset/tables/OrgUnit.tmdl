table OrgUnit

	column OrgUnitKey
		dataType: int64
		isHidden: true
		isKey: true
		lineageTag: col-orgunit-key
		summarizeBy: none
		sourceColumn: OrgUnitKey

	column Department
		dataType: string
		lineageTag: col-orgunit-dept
		summarizeBy: none
		sourceColumn: Department

	column Function
		dataType: string
		lineageTag: col-orgunit-function
		summarizeBy: none
		sourceColumn: Function

	column CostCentreCode
		dataType: string
		lineageTag: col-orgunit-cc
		summarizeBy: none
		sourceColumn: CostCentreCode

	partition OrgUnit = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(
			        File.Contents(DataFolder & "dim_org_unit.csv"),
			        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
			    ),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(
			        PromotedHeaders,
			        {
			        {"OrgUnitKey", Int64.Type},
			        {"Department", type text},
			        {"Function", type text},
			        {"CostCentreCode", type text}
			        },
			        "en-US"
			    )
			in
			    Typed
			```

	annotation PBI_ResultType = Table
