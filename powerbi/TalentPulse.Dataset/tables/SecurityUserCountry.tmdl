table SecurityUserCountry

	column UserEmail
		dataType: string
		isKey: true
		lineageTag: col-sec-email
		summarizeBy: none
		sourceColumn: UserEmail

	column Country
		dataType: string
		lineageTag: col-sec-country
		summarizeBy: none
		sourceColumn: Country

	partition SecurityUserCountry = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(
			        File.Contents(DataFolder & "security_user_country.csv"),
			        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
			    ),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(
			        PromotedHeaders,
			        {
			        {"UserEmail", type text},
			        {"Country", type text}
			        },
			        "en-US"
			    )
			in
			    Typed
			```

	annotation PBI_ResultType = Table
