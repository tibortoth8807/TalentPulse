table Source

	column SourceKey
		dataType: int64
		isHidden: true
		isKey: true
		lineageTag: col-source-key
		summarizeBy: none
		sourceColumn: SourceKey

	column SourceName
		dataType: string
		lineageTag: col-source-name
		summarizeBy: none
		sourceColumn: SourceName

	column SourceCategory
		dataType: string
		lineageTag: col-source-category
		summarizeBy: none
		sourceColumn: SourceCategory

	partition Source = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(
			        File.Contents(DataFolder & "dim_source.csv"),
			        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
			    ),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(
			        PromotedHeaders,
			        {
			        {"SourceKey", Int64.Type},
			        {"SourceName", type text},
			        {"SourceCategory", type text}
			        },
			        "en-US"
			    )
			in
			    Typed
			```

	annotation PBI_ResultType = Table
